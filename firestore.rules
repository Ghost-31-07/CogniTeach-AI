rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // User profiles & saved lesson plans
    match /users/{userId} {
      allow read, write: if isValidId(userId);

      match /lessonPlans/{lessonPlanId} {
        allow read, write: if isValidId(lessonPlanId);
      }
    }

    // Doubts & Student Questions across all subjects
    match /doubts/{doubtId} {
      allow read, write: if isValidId(doubtId);
    }

    // Student Progress & Mistake Analytics
    match /progress/{progressId} {
      allow read, write: if isValidId(progressId);
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
